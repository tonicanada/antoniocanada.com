---
// Sustituye a RelativityBackground.tsx, que traía three.js entero (456 KB de JS)
// y un requestAnimationFrame en bucle a todas las páginas para dibujar una malla
// wireframe gris #dddddd a opacity 0.15 — imperceptible en la práctica.
//
// Esto hace lo mismo con dos repeating-linear-gradient y 0 KB de JavaScript.
// La retícula es estática a propósito: la del original giraba a 0,0005 rad/frame,
// una velocidad que no se percibe pero que mantenía la GPU despierta y no
// respetaba prefers-reduced-motion.
//
// El motivo se queda porque encaja con el tema: la retícula de un plano técnico,
// no un degradado decorativo. Por eso el paso es de 64 px (módulo, no textura) y
// el contraste es mínimo — tiene que leerse como papel, no como fondo de pantalla.
---

<div class="grid-background" aria-hidden="true"></div>

<style>
  /* Retícula con `linear-gradient` (una línea) + `background-size` como paso,
     no con `repeating-linear-gradient`: sobre un patrón que ya se repite solo,
     `background-size` escala el motivo y engorda las líneas en vez de cambiar
     la separación. Así el paso es un número que se puede tocar. */
  .grid-background {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background-image:
      linear-gradient(to right, rgb(0 0 0 / 2.5%) 1px, transparent 1px),
      linear-gradient(to bottom, rgb(0 0 0 / 2.5%) 1px, transparent 1px);
    background-size: 64px 64px;
    /* Sin máscara de desvanecido. La tenía, y era un error: al ser una capa
       `fixed`, el degradado se mide contra la ventana y no contra el documento,
       así que quedaba una banda de bruma pegada a la pantalla —retícula en la
       mitad de arriba, nada en la de abajo— que no se movía nunca con el
       contenido. Al bajar parecía textura impresa en el cristal, y era buena
       parte de la sensación rara de scroll en la home. */
  }

  /* En móvil, 64 px son seis columnas en 390 px de ancho: la retícula deja de
     leerse como textura y empieza a leerse como tabla. Menos líneas y más
     separadas. */
  @media (max-width: 640px) {
    .grid-background {
      background-size: 96px 96px;
    }
  }
</style>
