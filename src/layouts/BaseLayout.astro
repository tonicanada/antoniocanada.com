---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import SideBar from "../components/SideBar.astro";
import GridBackground from "../components/GridBackground.astro";
import { ViewTransitions } from "astro:transitions";
import GtmScripts from "../components/analytics/GtmScripts.astro";
import GtmNoscript from "../components/analytics/GtmNoscript.astro";
import TrackingInit from "../components/analytics/TrackingInit.astro";
import CookieConsentBanner from "../components/CookieConsentBanner.astro";

import { SITE_TITLE, SITE_DESCRIPTION, TRANSITION_API } from "../config";

const {
  image,
  title = SITE_TITLE,
  description = SITE_DESCRIPTION,
  includeSidebar = true,
  sideBarActiveItemID,
  ogType,
  robots,
  // Datos estructurados propios de la página. Ver `BaseHead`.
  schema,
  // La retícula va SIEMPRE, y por eso ya no hay `enableGridBackground`. Estaba
  // apagada en las siete páginas de servicio, en `PostLayout` y en
  // `StoreItemLayout` — es decir, en todas las páginas de detalle, que son
  // justo donde se pasa el tiempo. La textura de marca sólo se veía en las
  // portadas. No era una decisión: es lo que quedó de cuando el fondo era
  // three.js y pesaba 456 KB. A 2,5 % de opacidad y 0 KB de JS no hay nada de
  // lo que proteger a una página.
  mainClass = "w-full px-5 sm:px-6 py-10 mx-auto max-w-wide",
  contentClass = "bg-transparent",
  shellClass = "bg-transparent",
  // El <html> es el contenedor de scroll, así que las utilidades que actúan
  // sobre él —scroll-snap, scroll-padding— tienen que aterrizar aquí y no en un
  // envoltorio interior. Sólo la home lo usa por ahora.
  htmlClass = "",
} = Astro.props;
---

<!doctype html>
<html lang="es" data-theme="lofi" class={htmlClass || undefined}>
  <head>
    <GtmScripts />
    <BaseHead
      title={title}
      description={description}
      image={image}
      ogType={ogType}
      robots={robots}
      schema={schema}
    />
    {TRANSITION_API && <ViewTransitions />}
    <TrackingInit />
    <CookieConsentBanner />
  </head>
  <body class="min-h-screen bg-white text-gray-900">
    <GtmNoscript />
    <GridBackground />

    <div class={`${shellClass} relative drawer min-h-screen lg:drawer-open`}>
      <input id="my-drawer" type="checkbox" class="drawer-toggle" />
      <div class={`drawer-content relative z-10 min-h-screen flex flex-col ${contentClass}`}>
        <Header title={SITE_TITLE} />
        <div class="flex-1 md:flex md:justify-center">
          <main class={mainClass}>
            <slot />
          </main>
        </div>
        <div class="mt-auto">
          <Footer />
        </div>
      </div>
      {
        includeSidebar && (
          <div class="drawer-side z-40 h-screen">
            <label for="my-drawer" class="drawer-overlay" />
            <SideBar sideBarActiveItemID={sideBarActiveItemID} />
          </div>
        )
      }
    </div>
  </body>
</html>
