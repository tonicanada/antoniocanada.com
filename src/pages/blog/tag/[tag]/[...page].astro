---
// Reimplementaba a mano el listado y la paginación que ya hace `PaginatedList`,
// y arrastraba lo que venía de la plantilla: el `<ul>` sin `<li>`, el título
// falso (un `<div class="text-3xl font-bold">` que no es un encabezado para
// nadie que no lo vea), los textos en inglés —"Sorry!", "Older Posts"— y un
// `post.data.heroImage` que no existe en el esquema del blog, así que ninguna
// tarjeta de esta página mostró nunca su imagen.
import BaseLayout from "@layouts/BaseLayout.astro";
import PaginatedList from "@components/PaginatedList.astro";
import { getCollection } from "astro:content";
import createSlug from "../../../../lib/createSlug";

export async function getStaticPaths({ paginate }) {
  const all_posts = await getCollection("blog");
  const all_tags = all_posts.flatMap((post) => {
    return post.data.tags || [];
  });

  return all_tags.flatMap((tag) => {
    const filtred_posts = all_posts.filter((post) => {
      return post.data.tags?.includes(tag);
    });
    return paginate(filtred_posts, {
      params: { tag },
      pageSize: 10,
    });
  });
}

const { page } = Astro.props;
const params = Astro.params;
---

<BaseLayout
  title={`Blog: ${params.tag}`}
  description={`Entradas del blog etiquetadas como ${params.tag}.`}
  sideBarActiveItemID="blog"
  robots="noindex,follow"
>
  <PaginatedList
    title={`Blog: ${params.tag}`}
    titleTag="h1"
    urlPrefix={`/blog/tag/${params.tag}`}
    page={page}
    cardProps={(post) => ({
      title: post.data.title,
      desc: post.data.description,
      img: post.data.image,
      url: "/blog/" + createSlug(post.data.title, post.slug, post.data.urlSlug),
      badge: post.data.badge,
      tags: post.data.tags,
    })}
  />
</BaseLayout>
