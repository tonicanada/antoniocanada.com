---
// Ahora es una capa fina sobre `PageLayout`: lo único propio de un post es que
// muestra fecha y etiquetas. La medida, el padding, la tipografía y la retícula
// las decide el layout común, así que un artículo y una página de servicio ya
// empiezan en la misma vertical y se leen con el mismo cuerpo.
//
// El bloque `<style is:global>` que había aquí para los `hr` se ha ido al tema
// de `prose` en tailwind.config.cjs, que es donde puede aplicarse también a las
// páginas `.astro`.
import { type BlogSchema } from "../content/config";
import PageLayout from "./PageLayout.astro";

export interface Props extends BlogSchema {
  kicker?: string;
  meta?: boolean;
  sideBarActiveItemID?: string;
}

const {
  title,
  description,
  publishDate,
  updatedDate,
  image,
  imageAspect,
  tags = [],
  kicker,
  meta = true,
  sideBarActiveItemID,
} = Astro.props;
---

<PageLayout
  title={title}
  description={description}
  image={image}
  imageAspect={imageAspect}
  kicker={kicker}
  publishDate={publishDate}
  updatedDate={updatedDate}
  tags={tags}
  meta={meta}
  ogType="article"
  sideBarActiveItemID={sideBarActiveItemID}
>
  <slot />
</PageLayout>
