---
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import '../styles/global.css';

export interface Props {
	title: string;
	description: string;
	image?: string;
	ogType?: string;
	robots?: string;
	/** Datos estructurados de la página, si tiene algo que declarar. */
	schema?: Record<string, any>;
}

const {
	title,
	description,
	image = '/social_img.webp',
	ogType = 'website',
	robots = 'index,follow',
	schema,
} = Astro.props;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url);

// El sitio no declaraba datos estructurados de ningún tipo. En un sitio que es
// todo servicios, eso deja al buscador adivinando quién los presta.
//
// Dos entidades, con `@id` estable y enlazadas entre sí: la PERSONA (a quien se
// busca por nombre) y el NEGOCIO (lo que se busca por "implementador de ERPNext
// en Chile"). Separarlas importa porque responden a consultas distintas, y
// `worksFor`/`employee` las mantiene como una sola cosa a ojos del buscador.
//
// `sameAs` es la pieza que faltaba y la de más valor por línea: sin ella, el
// nombre es una cadena de texto suelta en esta web; con ella queda reconciliado
// con los perfiles donde ya hay historial —LinkedIn, GitHub, YouTube—, que es
// como un motor (y un LLM que busca) decide que las menciones sueltas por ahí
// son de esta misma persona.
//
// `schema` deja que cada página añada lo suyo (un `Service`, un `FAQPage`) sin
// tocar esto.
const siteUrl = (Astro.site ?? new URL("/", Astro.url)).toString().replace(/\/$/, "");
const PERSON_ID = `${siteUrl}/#antonio`;
const BUSINESS_ID = `${siteUrl}/#negocio`;

const perfiles = [
	"https://www.linkedin.com/in/antoniocanada/",
	"https://github.com/tonicanada",
	"https://www.youtube.com/@contabilidad_erpnext",
];

const materias = [
	"ERPNext",
	"Frappe Framework",
	"ERP",
	"Facturación electrónica",
	"SII",
	"DTE",
	"Veri*Factu",
	"Contabilidad",
	"Automatización de procesos",
];

const personSchema = {
	"@context": "https://schema.org",
	"@type": "Person",
	"@id": PERSON_ID,
	name: "Antonio Cañada",
	url: `${siteUrl}/`,
	image: `${siteUrl}/profile.webp`,
	jobTitle: "Consultor ERPNext",
	description:
		"Consultor de ERPNext en Chile y España: implantación, localización fiscal (SII, Veri*Factu), integraciones y soporte.",
	email: "antonio@bizmotion.io",
	knowsLanguage: ["es", "en"],
	knowsAbout: materias,
	sameAs: perfiles,
	worksFor: { "@id": BUSINESS_ID },
};

// El tipo es `ProfessionalService` y no `Organization` a propósito: describe a
// quien presta un servicio profesional en un territorio, y trae `areaServed`,
// que es justo el eje por el que se pregunta ("¿en Chile?", "¿en España?").
const businessSchema = {
	"@context": "https://schema.org",
	"@type": "ProfessionalService",
	"@id": BUSINESS_ID,
	name: "Antonio Cañada — Implantación de ERPNext",
	url: `${siteUrl}/`,
	description:
		"Implantación, localización fiscal, integraciones, hosting y soporte de ERPNext para empresas en Chile, España y Bolivia.",
	founder: { "@id": PERSON_ID },
	employee: { "@id": PERSON_ID },
	email: "antonio@bizmotion.io",
	telephone: "+34626764393",
	sameAs: perfiles,
	knowsAbout: materias,
	availableLanguage: ["es", "en"],
	areaServed: [
		{ "@type": "Country", name: "Chile" },
		{ "@type": "Country", name: "España" },
		{ "@type": "Country", name: "Bolivia" },
	],
	serviceType: [
		"Implantación de ERPNext",
		"Migración a ERPNext",
		"Localización fiscal de ERPNext",
		"Integraciones y desarrollo sobre Frappe",
		"Hosting y soporte de ERPNext",
		"Capacitación técnica en ERPNext",
	],
};
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="canonical" href={canonicalUrl} />
<meta name="generator" content={Astro.generator} />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={ogType} />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={new URL(image, Astro.url)} />

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={Astro.url} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={new URL(image, Astro.url)} />
<meta name="robots" content={robots} />

<script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
<script type="application/ld+json" set:html={JSON.stringify(businessSchema)} />
{schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
