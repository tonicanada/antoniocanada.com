---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Mensaje enviado"
  description="Tu mensaje se ha enviado correctamente."
  robots="noindex,follow"
>
  <section class="py-16 text-center">
    <h1 class="text-4xl font-bold mb-4">📨 ¡Gracias por tu mensaje!</h1>
    <p class="text-lg text-gray-700 mb-8">
      He recibido tu consulta. Te responderé lo antes posible.
    </p>
    <a href="/" class="bg-blue-600 text-white px-6 py-3 rounded-lg hover:bg-blue-700">
      Volver al inicio
    </a>
  </section>
</BaseLayout>

<script>
  // Formspree redirige aquí solo si el envío del formulario de /contact fue
  // aceptado, así que llegar a esta página es la señal fiable de éxito
  // (ese formulario no tiene JS propio de éxito, ver docs/analytics.md).
  import { trackEvent } from "../lib/analytics";

  const ALREADY_FIRED_KEY = "generate_lead:contact:fired";
  if (!sessionStorage.getItem(ALREADY_FIRED_KEY)) {
    sessionStorage.setItem(ALREADY_FIRED_KEY, "1");
    trackEvent("generate_lead", { form_name: "contact" });
  }
</script>
