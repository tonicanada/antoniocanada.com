---
import { type StoreSchema } from "../content/config";
import PageLayout from "./PageLayout.astro";
import Button from "../components/Button.astro";

export interface Props extends StoreSchema {}

const {
  title,
  description,
  heroImage,
  pricing,
  oldPricing,
  checkoutUrl,
  badge,
  custom_link,
  custom_link_label,
} = Astro.props;
---

<PageLayout
  title={title}
  description={description}
  image={heroImage}
  kicker={badge}
  sideBarActiveItemID="store"
>
  <Fragment slot="lead">
    <div class="flex flex-wrap items-center justify-between gap-4 not-prose">
      <div>
        <span class="text-xl font-semibold text-gray-900">{pricing}</span>
        {oldPricing && <span class="ml-2 text-base text-gray-500 line-through">{oldPricing}</span>}
      </div>
      <div class="flex flex-wrap gap-3">
        {
          custom_link && (
            <Button href={custom_link} variant="secondary" size="sm" target="_blank" rel="noopener">
              {custom_link_label}
            </Button>
          )
        }
        {
          checkoutUrl && (
            <Button href={checkoutUrl} size="sm" target="_blank" rel="noopener">
              Comprar
            </Button>
          )
        }
      </div>
    </div>
  </Fragment>
  <slot />
</PageLayout>
