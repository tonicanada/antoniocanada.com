---
// Esta página reimplementaba a mano el <html>, el <head>, el navbar móvil y el
// drawer completos, en paralelo a BaseLayout. El coste no era teórico: la home
// —la URL que más se comparte del sitio— se quedó sin una sola etiqueta
// Open Graph, porque esas viven en BaseHead y aquí nunca se importó. Al pasar
// por BaseLayout las hereda, y además entra en ViewTransitions como el resto.
//
// El título y la descripción no cambian: BaseLayout ya usa SITE_TITLE y
// SITE_DESCRIPTION como valores por defecto, que es exactamente lo que este
// head declaraba a mano.
import BaseLayout from "../layouts/BaseLayout.astro";
import HeroSection from "../components/HeroSection.astro";
import EsquemaFlujo from "../components/EsquemaFlujo.astro";
import HomeContenido from "../components/HomeContenido.astro";

// Las secciones ponen su propio ancho y su propio padding, así que el <main>
// sólo tiene que dejarlas correr de borde a borde.
const mainClass = "w-full";

// Sin scroll-snap, en ninguna de sus variantes. Se probaron las tres y el
// patrón fue siempre el mismo: cada vez que se le pide al layout que garantice
// pantallas completas, aparece una ventana donde no puede.
//
// El número que lo cierra: el contenido del esquema mide 651 px, pero el alto
// útil de un portátil de 768 px de pantalla ronda los 640. En esa ventana no
// cabe ni quitándole todo el padding, así que "una sección, una pantalla" no es
// una promesa que se pueda cumplir. Y con la home en 2,7 pantallas y dos puntos
// de anclaje, alguna vista salía parcial por aritmética.
//
// Alinear a medias es lo que se leía como error: te dejaba la última caja del
// esquema cortada por 30 px. Sin promesa de alineación no hay nada que
// incumplir, y la página se lee como lo que es.
//
// El hero sí conserva la pantalla completa: eso es decisión de landing, no de
// mecánica de scroll, y no depende de que nada encaje después.
//
// `scroll-pt-16` se queda: descuenta el navbar sticky de 4rem de móvil, que si
// no tapa la cabecera de la sección a la que salta la flecha ↓ o un enlace con
// ancla. En `lg` no hay barra y el descuento se anula.
const htmlClass = "scroll-pt-16 lg:scroll-pt-0";
---

<BaseLayout sideBarActiveItemID="home" mainClass={mainClass} htmlClass={htmlClass}>
  <!-- El hero sí conserva la pantalla completa: es lo primero que se ve y
       quieres que ocupe todo. En móvil descuenta los 4rem del navbar sticky. -->
  <section
    id="hero"
    class="relative flex min-h-[calc(100dvh-4rem)] items-center justify-center px-6 py-8 lg:min-h-screen lg:py-0"
  >
    <HeroSection />
    <div
      id="scroll-indicator"
      class="absolute inset-x-0 bottom-6 flex justify-center text-2xl text-gray-500 transition-opacity duration-500 animate-bounce motion-reduce:animate-none"
    >
      <a href="#contenido" aria-label="Desliza hacia abajo">↓</a>
    </div>
  </section>

  <!-- Las dos secciones de abajo llevan espaciado fijo, no `min-h-screen`: con
       el alto atado a la ventana el ritmo cambiaba según la pantalla, largo en
       un portátil y con aire de sobra en un monitor grande.
       `lg:py-16` y no más: el esquema mide 651 px de contenido, y con los 96 px
       de `lg:py-24` que tenía antes la sección se iba a 843 px y se pasaba de
       una ventana de 813 por 30 px — justo lo que dejaba la última caja
       cortada. Con 64 px se queda en 779 y entra con holgura en las ventanas
       habituales. No es una garantía (en un portátil de 768 px de pantalla no
       cabe ni sin padding), pero ya no depende de ello. -->
  <section id="contenido" class="px-6 py-12 lg:py-16">
    <div class="mx-auto w-full max-w-4xl">
      <EsquemaFlujo />
    </div>
  </section>

  <!-- El id era `decidir` cuando aquí vivían las guías de /erpnext; ahora la
       sección es la petición de llamada y se llama por lo que hace. -->
  <section id="hablamos" class="px-6 py-12 lg:py-16">
    <div class="mx-auto w-full max-w-4xl">
      <HomeContenido />
    </div>
  </section>
</BaseLayout>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const indicator = document.getElementById("scroll-indicator");
    const target = document.getElementById("contenido");

    if (!indicator || !target) return;

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          const hidden = entry.isIntersecting;
          indicator.style.opacity = hidden ? "0" : "1";
          // Con sólo la opacidad a 0, la flecha seguía siendo clicable y
          // enfocable con Tab estando invisible.
          indicator.classList.toggle("pointer-events-none", hidden);
          indicator.setAttribute("aria-hidden", String(hidden));
        });
      },
      { threshold: 0.1 }
    );

    observer.observe(target);
  });
</script>
