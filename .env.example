# Variables de entorno del sitio. Copia a `.env` para desarrollo, y
# defínelas en el proyecto de Vercel para producción.
#
# Este fichero existe porque no lo había, y sin él no hay forma de comprobar
# qué le falta a producción. Concretamente: sin RESEND_API_KEY el formulario
# de contacto devolvía "gracias" sin avisar a nadie — ahora falla de forma
# ruidosa, pero mejor que no falte.

# --- Imprescindibles ---

# Aviso por correo de cada lead del formulario. SIN ESTA, el formulario
# devuelve error 500 a propósito: perder un lead en silencio es peor que
# mostrar un error.
RESEND_API_KEY=

# URL absoluta del sitio. La usa el checkout de Stripe para construir las URLs
# de éxito y cancelación.
PUBLIC_BASE_URL=https://antoniocanada.com

# La agenda a la que apuntan todos los botones de "Agendar llamada".
PUBLIC_AGENDAR_URL=
PUBLIC_GOOGLE_CALENDAR_BOOKING_URL=

# --- Opcionales ---

# Contenedor de Google Tag Manager. Sin esto no hay analítica.
PUBLIC_GTM_ID=

# Cobro del blueprint con tarjeta. Sin esto, /services/diagnostico-procesos
# no puede crear la sesión de pago.
STRIPE_SECRET_KEY=

# Remitente y destinatario de los avisos. Tienen valores por defecto en el
# código, así que pueden quedar vacías.
BOOKING_CLICK_FROM=
LEAD_NOTIFY_TO=
# Pon "false" para desactivar los avisos por correo (p. ej. en local).
BOOKING_CLICK_NOTIFY=

# Webhook del bootcamp de 2025. El endpoint que lo usaba ya devuelve 410, así
# que esta variable está muerta: se puede borrar junto con
# src/pages/api/stripe-webhook-bootcamp-nov2025.ts.
STRIPE_WEBHOOK_SECRET_BOOTCAMP_NOV=
