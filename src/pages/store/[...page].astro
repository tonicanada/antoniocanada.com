---
import BaseLayout from "../../layouts/BaseLayout.astro";
import HorizontalShopItem from "../../components/HorizontalShopItem.astro";
import { getCollection } from "astro:content";

export async function getStaticPaths({ paginate }) {
  const items = await getCollection("store");
  items.sort((a, b) => b.data.updatedDate.valueOf() - a.data.updatedDate.valueOf());
  return paginate(items, { pageSize: 10 });
}
const { page } = Astro.props;
---

<BaseLayout
  title="Tienda"
  description="Materiales y recursos descargables sobre ERPNext."
  sideBarActiveItemID="store"
>
  <h1 class="mb-5 text-3xl font-semibold text-gray-900">Tienda</h1>

  <ul class="space-y-6">
    {
      page.data.map((item) => (
        <li>
          <HorizontalShopItem
            title={item.data.title}
            img={item.data.image}
            desc={item.data.description}
            pricing={item.data.pricing}
            oldPricing={item.data.oldPricing}
            checkoutUrl={item.data.checkoutUrl}
            badge={item.data.badge}
            url={"/store/" + item.slug}
            custom_link={item.data.custom_link}
            custom_link_label={item.data.custom_link_label}
          />
        </li>
      ))
    }
  </ul>

  {
    (page.url.prev || page.url.next) && (
      <nav class="mt-10 flex items-center justify-between" aria-label="Paginación">
        {page.url.prev ? (
          <a
            href={page.url.prev}
            rel="prev"
            class="text-sm font-semibold text-gray-700 underline underline-offset-4 hover:text-black"
          >
            ← Anterior
          </a>
        ) : (
          <span />
        )}
        {page.url.next ? (
          <a
            href={page.url.next}
            rel="next"
            class="text-sm font-semibold text-gray-700 underline underline-offset-4 hover:text-black"
          >
            Siguiente →
          </a>
        ) : (
          <span />
        )}
      </nav>
    )
  }
</BaseLayout>
