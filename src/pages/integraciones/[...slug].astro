---
import { CollectionEntry, getCollection } from "astro:content";
import PostLayout from "../../layouts/PostLayout.astro"; // o PostLayout si usas el mismo
import { IntegracionSchema } from "../../content/config";
import createSlug from "../../lib/createSlug";

export async function getStaticPaths() {
  const entradas = await getCollection("integraciones");
  return entradas.map((entry) => ({
    params: { slug: createSlug(entry.data.title, entry.slug, entry.data.urlSlug) },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<"integraciones">;
}

const { entry } = Astro.props;
const integracion: IntegracionSchema = entry.data;
const { Content } = await entry.render();
---

<PostLayout
  title={integracion.title}
  description={integracion.description}
  publishDate={integracion.publishDate}
  image={integracion.image}
  tags={integracion.tags}
  github={integracion.github}
  demo={integracion.demo}
>
  <Content />
</PostLayout>
