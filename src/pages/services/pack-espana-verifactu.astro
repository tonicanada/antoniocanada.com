---
import PageLayout from "../../layouts/PageLayout.astro";
import ServiceLeadForm from "../../components/ServiceLeadForm.astro";
import Panel from "../../components/Panel.astro";
import { paises } from "../../data/servicios";

// Los dos vídeos son el activo de esta página: es la única prueba end-to-end
// que hay en el sitio de que la emisión con Veri*Factu funciona de verdad. Antes
// estaban partidos en dos bloques idénticos copiados; ahora salen de una lista.
const videos = [
  {
    id: "e5Qj8wivNCQ",
    titulo: "Emisión y validación end-to-end",
    iframeTitle: "ERPNext + Veri*Factu: emitir factura y validar con Hacienda",
    pie: "Emitir una factura en ERPNext, generar el PDF con QR y validarlo ante Hacienda.",
  },
  {
    id: "7l5N9ZlhlqI",
    titulo: "Facturas rectificativas",
    iframeTitle: "ERPNext + Veri*Factu: facturas rectificativas",
    pie: "Cómo emitir facturas rectificativas y validarlas con Hacienda.",
  },
];
---

<PageLayout
  title="Pack España: ERPNext + contabilidad + Veri*Factu"
  headTitle="Pack España: ERPNext + Contabilidad + Veri*Factu"
  description="ERPNext listo para España: plan contable e impuestos, emisión con Veri*Factu y PDF con QR validable ante Hacienda. Con la implantación y el acompañamiento incluidos."
  kicker="Servicio · España"
  lead="ERPNext funcionando con el plan contable español, el IVA y las retenciones configurados, y la emisión con Veri*Factu conectada: PDF con QR que Hacienda valida, rectificativas incluidas."
  sideBarActiveItemID="services"
>
  <h2>Qué incluye</h2>
  <ul>
    <li>Plan contable español, IVA y retenciones configurados sobre tu estructura real.</li>
    <li>Emisión con <strong>Veri*Factu</strong>, incluidas las facturas rectificativas.</li>
    <li>PDF con QR validable ante Hacienda.</li>
    <li>Implantación guiada y acompañamiento durante el arranque.</li>
  </ul>

  <h2>Cómo se ve funcionando</h2>
  <p>
    No es una demo de diapositivas: en los dos vídeos se emite contra Hacienda y
    se valida el resultado.
  </p>
  {
    videos.map((v) => (
      <figure class="not-prose my-8">
        <h3 class="mb-3 text-lg font-semibold text-gray-900">{v.titulo}</h3>
        <div class="relative w-full overflow-hidden rounded-md border border-gray-200 bg-black pt-[56.25%]">
          <iframe
            class="absolute inset-0 h-full w-full"
            src={`https://www.youtube-nocookie.com/embed/${v.id}?rel=0`}
            title={v.iframeTitle}
            loading="lazy"
            referrerpolicy="strict-origin-when-cross-origin"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
            allowfullscreen
          />
        </div>
        <figcaption class="mt-2 text-sm text-gray-600">{v.pie}</figcaption>
      </figure>
    ))
  }

  <h2>Qué cuesta</h2>
  {/* Aquí ponía "A medida" y nada más, que es justo lo que estrechaba el
      embudo: el visitante no sabía si estaba en su orden de magnitud y no
      llamaba. La salida acordada es publicar la composición, no un "desde X". */}
  <p>
    Se cobra por componentes: puesta en marcha, localización fiscal, migración
    de datos y la cuota mensual de hosting y soporte. El desglose con los
    importes está en <a href={paises.es.url}>la página de precios de España</a>.
  </p>

  <Panel class="not-prose my-8 border-amber-300 bg-amber-50/80">
    <p class="font-semibold text-gray-900">
      Programa de primeras implantaciones (cupos limitados)
    </p>
    <p class="mt-2 text-sm text-gray-700">
      Las primeras empresas entran con condiciones preferentes a cambio de
      feedback durante el arranque.
    </p>
  </Panel>

  <ServiceLeadForm
    slot="footer"
    servicio="pack-espana-verifactu"
    heading="¿Lo montamos en tu empresa?"
    subheading="Déjame tus datos y cómo facturas hoy; te digo qué haría falta en tu caso."
  />
</PageLayout>
