---
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "../components/Button.astro";
---

<BaseLayout
  title="Pago cancelado"
  description="El pago no se ha completado."
  robots="noindex,follow"
>
  <section class="py-16 text-center">
    <h1 class="text-4xl font-bold mb-4">⚠️ Pago cancelado</h1>
    <p class="text-lg text-gray-700 mb-8">
      No te preocupes, puedes intentarlo de nuevo cuando quieras.  
      Si necesitas ayuda, ponte en contacto conmigo.
    </p>
    <div class="flex flex-col items-center justify-center gap-4 sm:flex-row">
      <Button href="/services/">Volver a servicios</Button>
      <Button href="/contact/" variant="secondary">Escríbeme</Button>
    </div>
  </section>
</BaseLayout>
