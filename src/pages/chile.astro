---
import BaseLayout from "../layouts/BaseLayout.astro";
import TablaComponentes from "../components/TablaComponentes.astro";
import ServiceLeadForm from "../components/ServiceLeadForm.astro";
import { paises } from "../data/servicios";

// Landing de intención local. Según Search Console, "erpnext chile" está en
// posición 4,9 con 25 impresiones: es la única consulta con intención comercial
// que ya posiciona, y hoy la respondía una home genérica.
//
// Cuidado con lo que se afirma: la conexión con el SII está construida y
// corriendo (compras en producción, emisión validada en certificación). El F29,
// Previred y la UF se mencionan como lo que son —cosas que la configuración
// contempla— y no como integraciones automáticas, porque no lo son.
const pais = paises.cl;

// Las preguntas están redactadas COMO SE PREGUNTAN, no como se titula una
// sección: "quién implementa ERPNext en Chile" es la consulta real, y hasta
// ahora ninguna página del sitio contenía esa frase. Sirve para dos cosas a la
// vez: el `FAQPage` de abajo, y que un asistente que busca en vivo encuentre la
// respuesta en un párrafo corto y citable en vez de tener que destilarla.
//
// Una sola fuente: de aquí salen el bloque visible y el JSON-LD. Las respuestas
// van en texto plano a propósito, para que las dos versiones no se separen.
const faqs = [
  {
    q: "¿Quién implementa ERPNext en Chile?",
    a: "Antonio Cañada. Implanto ERPNext para empresas chilenas con la localización hecha: conexión al SII en los dos sentidos, folios CAF, RCV, plan de cuentas chileno, UF y multiempresa. La parte de compras corre en producción en cuatro empresas de un grupo constructor y la emisión de venta está validada contra el ambiente de certificación del SII.",
  },
  {
    q: "¿ERPNext puede emitir facturas electrónicas al SII?",
    a: "Sí, con la integración que mantengo: emisión de DTE con folios CAF administrados desde el propio sistema, envío al SII, consulta de estado y PDF con timbre en formato carta y cedible. Del lado de la compra, el RCV y la casilla de correo entran solos, con clasificación de los XML, aceptación o reclamo y boletas de honorarios.",
  },
  {
    q: "¿Cuánto cuesta implementar ERPNext en Chile?",
    a: "Los precios están publicados en esta misma página, en UF y con su referencia en pesos. Un proyecto no es un precio único: se compone de piezas —localización fiscal, migración, integraciones, hosting y soporte, capacitación— y no todas hacen falta en todos los casos. Lo predecible va a precio fijo y sólo el modelado de procesos va por tramos.",
  },
  {
    q: "¿ERPNext sirve para una constructora?",
    a: "Es el sector que trabajo con más profundidad, desde dentro de una constructora chilena. La unidad de análisis es la obra, no la empresa: resultado por obra al día, subcontratos con estados de pago y retenciones, bodega por obra, cajas chicas, provisiones, remuneraciones imputadas a su centro de costo y activos fijos con ubicación.",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};
---

<BaseLayout
  title="ERPNext en Chile: SII, DTE y contabilidad chilena"
  description="Implantación de ERPNext en Chile con la conexión al SII funcionando: emisión y recepción de DTE, folios CAF, RCV, plan de cuentas chileno y conciliación bancaria. Precios en UF."
  sideBarActiveItemID="services"
  schema={faqSchema}
>
  <div class="pb-12 mt-5">
    <p class="text-sm font-semibold uppercase tracking-[0.2em] text-gray-500">
      Chile
    </p>
    <h1 class="mt-2 text-3xl sm:text-4xl font-semibold text-gray-900">
      ERPNext en Chile, con el SII funcionando de verdad
    </h1>
    <p class="mt-4 text-lg text-gray-600">
      Un ERP internacional que no sabe de DTE, de folios CAF ni del RCV te deja
      a medias: acabas con un portal de facturación aparte y alguien cuadrando
      las diferencias. Aquí la facturación electrónica no es un añadido, es
      parte del sistema.
    </p>

    <section class="mt-12" aria-labelledby="que-esta-resuelto">
      <h2 id="que-esta-resuelto" class="text-2xl font-semibold text-gray-900">
        Qué está resuelto para Chile
      </h2>

      <ul class="mt-4 space-y-3 text-gray-700">
        <li>
          <strong class="font-semibold text-gray-900">SII, en los dos sentidos.</strong>
          Emisión de DTE con folios CAF administrados desde el sistema, envío,
          consulta de estado y PDF con timbre en carta y cedible. Y del lado de
          la compra: RCV, lectura de la casilla de correo, clasificación de los
          XML, aceptación o reclamo, y boletas de honorarios.
          <a href="/integraciones/sii-chile/" class="underline underline-offset-2"
            >Cómo funciona</a
          >.
        </li>
        <li>
          <strong class="font-semibold text-gray-900">Contabilidad chilena.</strong>
          Plan de cuentas y configuración de impuestos pensada para el F29, con
          los centros de costo que tu operación necesite.
        </li>
        <li>
          <strong class="font-semibold text-gray-900">Banco.</strong>
          Los movimientos entran solos y la conciliación es asistida, sin bajar
          cartolas ni subir archivos.
          <a href="/integraciones/banco/" class="underline underline-offset-2"
            >Cómo funciona</a
          >.
        </li>
        <li>
          <strong class="font-semibold text-gray-900">Licitaciones y compras.</strong>
          El requerimiento nace en ERPNext, se licita, y la adjudicación vuelve
          convertida en orden de compra.
          <a href="/integraciones/sourcing/" class="underline underline-offset-2"
            >Cómo funciona</a
          >.
        </li>
        <li>
          <strong class="font-semibold text-gray-900">UF, monedas y multiempresa.</strong>
          Contratos y documentos en UF, y varias sociedades en una sola
          instalación, cada una con sus credenciales y su numeración.
        </li>
        <li>
          <strong class="font-semibold text-gray-900">Centros de costo.</strong>
          La estructura sobre la que se imputa cada gasto a su obra o proyecto —
          materiales, subcontratos y servicios—, que es lo que hace que el
          resultado por obra sea real y no una estimación. La imputación de
          remuneraciones se modela como
          <a href="/construccion/" class="underline underline-offset-2"
            >uno de los procesos del sector</a
          >.
        </li>
      </ul>

      <p class="mt-6 text-base text-gray-600">
        La parte de compras <strong class="font-semibold text-gray-800"
          >corre en producción</strong
        > en cuatro empresas de un grupo constructor, sincronizando el RCV y el
        correo a diario. La emisión de venta está validada contra el ambiente de
        certificación del SII y en despliegue.
      </p>
    </section>

    <section class="mt-14" aria-labelledby="construccion">
      <h2 id="construccion" class="text-2xl font-semibold text-gray-900">
        Construcción, en concreto
      </h2>
      <p class="mt-3 text-base text-gray-600">
        Es el sector que conozco mejor, porque llevo años dentro de una
        constructora chilena y no leyéndolo en un folleto. En construcción la
        unidad de análisis no es la empresa, es la obra — y ahí es donde casi
        todos los ERP dejan a medias: el resultado por obra acaba armándolo una
        persona en Excel, dos meses tarde.
      </p>
      <p class="mt-3 text-base text-gray-600">
        Resultado por obra al día, control de subcontratos con sus estados de
        pago y retenciones, bodega e inventario por obra, cajas chicas,
        provisiones, remuneraciones imputadas a su centro de costo y activos
        fijos con su ubicación.
        <a href="/construccion/" class="font-semibold text-gray-900 underline underline-offset-2"
          >Los ocho procesos, en detalle</a
        >.
      </p>
      <p class="mt-3 text-base text-gray-600">
        También he trabajado con empresas de maquinaria (control de leasings),
        inmobiliarias y oficinas de arquitectura (ingreso de horas por proyecto).
      </p>
    </section>

    <section class="mt-14" aria-labelledby="codigo-abierto">
      <h2 id="codigo-abierto" class="text-2xl font-semibold text-gray-900">
        El código, en abierto
      </h2>
      <p class="mt-3 text-base text-gray-600">
        Parte de esto no hay que creérselo: está publicado y se puede leer,
        instalar y bifurcar. Es también la razón de que este enlace exista en
        los dos sentidos — el repositorio apunta a esta web y esta web al
        repositorio.
      </p>
      <ul class="mt-4 space-y-3 text-gray-700">
        <li>
          <a
            href="https://github.com/tonicanada/sii_chile_xml_to_pdf"
            rel="noopener"
            class="font-semibold text-gray-900 underline underline-offset-2"
            >sii_chile_xml_to_pdf</a
          > — convierte los XML de DTE del SII a PDF con su timbre PDF417, en CLI
          o como microservicio. Es el más usado de los tres.
        </li>
        <li>
          <a
            href="https://github.com/tonicanada/erpnext_chile_factura"
            rel="noopener"
            class="font-semibold text-gray-900 underline underline-offset-2"
            >erpnext_chile_factura</a
          > — la app de ERPNext que recibe las facturas de compra desde el SII,
          guarda los XML de respaldo y genera la <em>Purchase Invoice</em> con reglas
          configurables.
        </li>
        <li>
          <a
            href="https://github.com/tonicanada/dte_email_xml_processor_chile"
            rel="noopener"
            class="font-semibold text-gray-900 underline underline-offset-2"
            >dte_email_xml_processor_chile</a
          > — clasifica la casilla de intercambio DTE completa: facturas, boletas,
          acuses, recibos, respuestas del SII y avisos de cesión del RPETC.
        </li>
      </ul>
    </section>

    <section class="mt-14" aria-labelledby="precios-cl">
      <h2 id="precios-cl" class="text-2xl font-semibold text-gray-900">
        Precios en Chile
      </h2>
      <p class="mt-3 text-base text-gray-600">
        Un proyecto no es un precio único: son estas piezas, y no todas hacen
        falta en todos los casos. Los importes van en UF —la convención chilena
        para que un precio no se mueva con el peso— con su referencia en pesos
        al lado. Lo predecible va a precio fijo; sólo una línea va por
        presupuesto, y abajo está explicado por qué.
      </p>
      <div class="mt-6">
        <TablaComponentes pais={pais} />
      </div>
    </section>

    <section class="mt-14" aria-labelledby="preguntas-cl">
      <h2 id="preguntas-cl" class="text-2xl font-semibold text-gray-900">
        Preguntas frecuentes sobre ERPNext en Chile
      </h2>
      <dl class="mt-6 space-y-6">
        {
          faqs.map((f) => (
            <div>
              <dt class="text-base font-semibold text-gray-900">{f.q}</dt>
              <dd class="mt-2 text-base text-gray-600">{f.a}</dd>
            </div>
          ))
        }
      </dl>
      <p class="mt-6 text-sm text-gray-600">
        Las preguntas que no dependen del país —si trabajo solo, el mínimo de
        presupuesto, si merece la pena moverse— están en
        <a href="/services/#preguntas" class="underline underline-offset-2"
          >las preguntas frecuentes de servicios</a
        >.
      </p>
    </section>

    <div class="mt-14">
      <ServiceLeadForm
        servicio="chile"
        heading="Hablemos de tu empresa en Chile"
        subheading="Déjame tus datos y qué sistemas usas hoy; luego podrás elegir un horario en mi agenda."
      />
    </div>

    <p class="mt-10 text-sm text-gray-600">
      ¿En España? Hay una
      <a href="/espana/" class="underline underline-offset-2">página para España</a>
      con Veri*Factu y precios en euros.
    </p>
  </div>
</BaseLayout>
